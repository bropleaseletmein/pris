<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Library" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <bpmn:collaboration id="Collab_Library">
    <bpmn:participant id="P_ISU" name="ИСУ ИТМО" />
    <bpmn:participant id="P_Main" name="Кафедра: публикация и получение учебных материалов" processRef="Proc_Library" />
    <bpmn:participant id="P_ID" name="ITMO ID" />
    <bpmn:messageFlow id="M1" name="Аутентификация" sourceRef="T1" targetRef="P_ID" />
    <bpmn:messageFlow id="M2" name="Аутентификация" sourceRef="U1" targetRef="P_ID" />
    <bpmn:messageFlow id="M3" name="Группы, дисциплины" sourceRef="P_ISU" targetRef="S4" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Library" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="LaneT" name="Преподаватель">
        <bpmn:flowNodeRef>StartT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LaneS" name="ИС «Электронная библиотека»">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndPub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndDeny</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LaneU" name="Студент">
        <bpmn:flowNodeRef>StartS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndS</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartT" name="Нужно опубликовать материал">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Войти через ITMO ID">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="Загрузить файл и метаданные">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T3" name="Исправить метаданные">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S1" name="Проверить метаданные">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW1" name="Метаданные заполнены?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S2" name="Сохранить файл и версию">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S3" name="Индексировать текст">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S4" name="Открыть доступ по группам">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="E1" name="Уведомить студентов">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_E1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndPub" name="Материал опубликован">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S6" name="Проверить права доступа">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW2" name="Доступ разрешён?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S7" name="Выдать файл, учесть просмотр">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S8" name="Сообщить об отказе">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndDeny" name="Доступ отклонён">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartS" name="Нужен учебный материал">
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="U1" name="Войти через ITMO ID">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U2" name="Найти материал">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U3" name="Открыть или скачать">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndS" name="Материал получен">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="StartT" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="S1" />
    <bpmn:sequenceFlow id="F4" sourceRef="S1" targetRef="GW1" />
    <bpmn:sequenceFlow id="F5" name="Да" sourceRef="GW1" targetRef="S2" />
    <bpmn:sequenceFlow id="F6" name="Нет" sourceRef="GW1" targetRef="T3" />
    <bpmn:sequenceFlow id="F7" sourceRef="T3" targetRef="S1" />
    <bpmn:sequenceFlow id="F8" sourceRef="S2" targetRef="S3" />
    <bpmn:sequenceFlow id="F9" sourceRef="S3" targetRef="S4" />
    <bpmn:sequenceFlow id="F10" sourceRef="S4" targetRef="E1" />
    <bpmn:sequenceFlow id="F11" sourceRef="E1" targetRef="EndPub" />
    <bpmn:sequenceFlow id="F12" sourceRef="StartS" targetRef="U1" />
    <bpmn:sequenceFlow id="F13" sourceRef="U1" targetRef="U2" />
    <bpmn:sequenceFlow id="F14" sourceRef="U2" targetRef="S6" />
    <bpmn:sequenceFlow id="F15" sourceRef="S6" targetRef="GW2" />
    <bpmn:sequenceFlow id="F16" name="Да" sourceRef="GW2" targetRef="S7" />
    <bpmn:sequenceFlow id="F17" name="Нет" sourceRef="GW2" targetRef="S8" />
    <bpmn:sequenceFlow id="F18" sourceRef="S8" targetRef="EndDeny" />
    <bpmn:sequenceFlow id="F19" sourceRef="S7" targetRef="U3" />
    <bpmn:sequenceFlow id="F20" sourceRef="U3" targetRef="EndS" />
  </bpmn:process>
